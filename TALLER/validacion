-- CONSULTA ORIGINAL
SELECT *
FROM cliente
WHERE YEAR(fecha_registro) = 2025
AND ciudad = 'Manizales';

-- CONSULTA MODIFICADA
SELECT *
FROM cliente
WHERE fecha_registro >= '2025-01-01'
AND fecha_registro < '2026-01-01'
AND ciudad = 'Manizales';

EXPLAIN
SELECT *
FROM cliente
WHERE YEAR(fecha_registro) = 2025
AND ciudad = 'Manizales';


EXPLAIN
SELECT *
FROM cliente
WHERE fecha_registro >= '2025-01-01'
AND fecha_registro < '2026-01-01'
AND ciudad = 'Manizales';


